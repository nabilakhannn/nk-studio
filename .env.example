PORT=4180
HOST=127.0.0.1
HF_MODE=live
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HIGGSFIELD_TRACKING_URL=https://higgsfield.ai/?fpr=replace-with-your-tracking-code

# Required only when hosting NK Studio for multiple visitors.
# Use at least 32 random characters. This signs browser sessions and encrypts saved API credentials.
NK_SESSION_SECRET=

# Recommended on Railway: mount a persistent volume and set this to its mount path.
# NK_DATA_DIR=/data

# NK Studio intentionally locks requests to https://api.higgsfield.ai.

# Optional: point to an existing private .env file instead of copying secrets.
# NK_CREDENTIALS_ENV=/absolute/path/to/private/.env
